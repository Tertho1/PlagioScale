# =============================================================================
# PlagioScale Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# cp .env.example .env
# =============================================================================

# --- Database (PostgreSQL) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=plagioscale
DB_USER=plagio
DB_PASSWORD=plagio_pass
# Full URL override (takes precedence over individual DB_* vars)
DATABASE_URL=

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- JWT Authentication ---
JWT_SECRET=please-change-this-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Worker ---
WORKER_ID=worker-default
API_HOST=api-service
API_PORT=8000

# --- Autoscaler ---
COMPOSE_PROJECT_NAME=plagioscale
SCALE_UP_THRESHOLD=10
SCALE_DOWN_THRESHOLD=3
MIN_WORKERS=1
MAX_WORKERS=5
COOLDOWN_SECONDS=20
POLL_INTERVAL=5
AUTOSCALER_EVENTS_KEY=autoscaler_events

# --- Host Autoscaler (scripts/host_autoscaler.py) ---
DOCKER_COMPOSE_CMD=docker compose
REDIS_SERVICE_NAME=redis
WORKER_SERVICE_NAME=worker

# --- Monitoring ---
# (uses REDIS_HOST, REDIS_PORT, COMPOSE_PROJECT_NAME, AUTOSCALER_EVENTS_KEY)

# --- Frontend ---
VITE_API_BASE=http://localhost:8000
