# =============================================================================
# PlagioScale Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# cp .env.example .env
# =============================================================================

# --- Database (PostgreSQL) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=plagioscale
DB_USER=plagio
DB_PASSWORD=plagio_pass
DATABASE_URL=

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=plagio_redis_pass

# --- JWT Authentication ---
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Worker ---
WORKER_ID=worker-default
WORKER_SECRET=change-this-to-another-random-string
API_HOST=api-service
API_PORT=8000

# --- Autoscaler ---
COMPOSE_PROJECT_NAME=plagioscale
SCALE_UP_THRESHOLD=10
SCALE_DOWN_THRESHOLD=3
MIN_WORKERS=1
MAX_WORKERS=5
COOLDOWN_SECONDS=20
POLL_INTERVAL=5
AUTOSCALER_EVENTS_KEY=autoscaler_events

# --- SMTP (optional — leave empty to disable email) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@plagioscale.local
SMTP_USE_TLS=true

# --- Frontend ---
VITE_API_BASE=http://localhost:8000

# --- mTLS (optional — set to true to enable mutual TLS between services) ---
USE_MTLS=false
